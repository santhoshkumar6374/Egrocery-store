# ==========================================
# E-Grocery Store Production Environment Variables
# ==========================================

# Server
PORT=8080

# Production Managed MySQL Database (e.g. Aiven / TiDB Cloud)
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/your_database_name?useSSL=true&enabledTLSProtocols=TLSv1.2,TLSv1.3
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# Local Docker Database (for local dev only)
DB_NAME=egrocery_db
DB_ROOT_PASSWORD=your_local_root_password
DB_USERNAME=egrocery_app
DB_PASSWORD=your_local_db_password

# JWT Authentication Secret (Minimum 256-bit strong secret string)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS & Allowed Origins (Comma-separated URLs, e.g., Cloudflare Pages domain)
CORS_ORIGINS=https://your-frontend.pages.dev,http://localhost:5173

# Frontend Public Base URL (for email links, etc.)
FRONTEND_BASE_URL=https://your-frontend.pages.dev
VITE_API_BASE_URL=https://your-backend.onrender.com

# Cloudinary (Persistent Image Upload Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Shop Details
SHOP_NAME=My Grocery Store
SHOP_LATITUDE=11.6643
SHOP_LONGITUDE=78.1460

# Initial Admin Account Creation
ADMIN_EMAIL=admin@egrocery.com
ADMIN_PASSWORD=YourAdminPassword123!

# Mail SMTP Credentials (Gmail App Password or SendGrid/Brevo)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-digit-app-password

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenAI AI Chatbot (Optional)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini